---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Placeholder</h1>
			<p>
			this will be a blog for me to write my thoughts on tech and AI and stuff.

			I'm doing it because agents are getting *so good* and I want to capture my thought process as
			things evolve so quickly and fast.
			</p>
			<p><a href={withBase('/blog')}>Read the blog →</a></p>
		</main>
		<Footer />
	</body>
</html>
